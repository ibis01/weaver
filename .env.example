# Never commit real values. Configure production secrets in the host secret manager.
NODE_ENV=production
REDIS_URL=rediss://user:password@redis.example.com:6380
REDIS_NAMESPACE=weaver
ALLOWED_ORIGINS=https://weaver.example.com
TRUST_PROXY_HOPS=1
PROXY_PORT=3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
API_FAILURE_ALERT_THRESHOLD=10
ALERT_WEBHOOK_URL=https://alerts.example.com/weaver
MEME_SNAPSHOT_INTERVAL_MS=900000
WEB_BIND=127.0.0.1
WEB_PORT=8080
