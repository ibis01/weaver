# Never commit real values. Configure production secrets in the host
# secret manager.
NODE_ENV=production

# Redis. The compose file (docker-compose.meme.yml) sets this
# internally to redis://redis:6379, so this value only matters
# when running the workers outside Docker.
REDIS_URL=rediss://user:password@redis.example.com:6380
REDIS_NAMESPACE=weaver

# Snapshot worker (scripts/meme-snapshot-worker.js)
MEME_SNAPSHOT_INTERVAL_MS=900000

# Calibration worker (scripts/meme-calibration-worker.js)
#   WEAVER_WORKER_BASE: the deployed Worker. Not secret; it is the
#   public proxy URL. The calibration worker reads alerts through
#   GET /meme/alerts, so this must resolve to the same Worker that
#   receives POST /meme/alert from the browser.
WEAVER_WORKER_BASE=https://weaver-proxy.ibis01-weaver.workers.dev
MEME_CALIBRATION_INTERVAL_MS=3600000
MEME_CALIBRATION_HORIZON_HOURS=24
MEME_CALIBRATION_MAX_AGE_HOURS=168
