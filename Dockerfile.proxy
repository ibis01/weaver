FROM node:22.13.0-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY proxy-server.js ./
COPY server ./server

RUN addgroup -S weaver && adduser -S -G weaver weaver \
  && chown -R weaver:weaver /app
USER weaver
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e 'fetch(`http://127.0.0.1:${process.env.PROXY_PORT || 3001}/health`).then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "proxy-server.js"]