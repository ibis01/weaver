FROM node:22.22.2-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY dist/bundle.js                ./dist/bundle.js
COPY server/smart-money-store.js   ./server/smart-money-store.js
COPY server/smart-money-shim.js    ./server/smart-money-shim.js
COPY scripts/smart-money-worker.js ./scripts/smart-money-worker.js
COPY data/eth-watchlist.json       ./data/eth-watchlist.json

RUN addgroup -S weaver && adduser -S -G weaver weaver \
  && chown -R weaver:weaver /app
USER weaver

CMD ["node", "scripts/smart-money-worker.js"]
