{
  "scripts": {
    "build": "node concat.js",
    "minify": "esbuild dist/bundle.js --minify --outfile=dist/bundle.min.js",
    "test:unit": "npx mocha --require test/setup.js --ui bdd test/unit/**/*.test.js",
    "test:integration": "npx mocha --require test/setup.js --ui bdd test/integration/**/*.test.js",
    "test:security": "npx mocha --require test/setup.js --ui bdd test/security/**/*.test.js",
    "test:e2e": "npx playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axios": "^1.20.0",
    "chai": "^6.2.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
