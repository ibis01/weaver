{
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "test:unit": "mocha --require test/setup.js --ui bdd test/unit/**/*.test.js",
    "test:integration": "mocha --require test/setup.js --ui bdd test/integration/**/*.test.js",
    "test:security": "mocha --require test/setup.js --ui bdd test/security/**/*.test.js",
    "test:e2e": "playwright test",
    "build": "node concat.js",
    "minify": "esbuild dist/bundle.js --minify --outfile=dist/bundle.min.js"
  }
}
